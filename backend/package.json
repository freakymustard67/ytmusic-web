{
  "name": "@ytmusic-web/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('assets','dist/assets',{recursive:true})\"",
    "start": "node dist/index.js",
    "bench": "node ../research/poc/bench-node.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bundle:botguard": "esbuild bg-entry.mjs --bundle --format=iife --platform=browser --outfile=assets/bg.bundle.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "googlevideo": "^4.1.1",
    "youtubei.js": "^18.1.0",
    "bgutils-js": "^4.0.3",
    "jsdom": "^30.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}